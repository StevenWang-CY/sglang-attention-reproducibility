# Local-only research material, presentations, sites, drafts, and caches
/_local/

# Editors and agent-local state
/.vscode/
/.idea/
/.claude/

# OS and temporary office files
.DS_Store
Thumbs.db
~$*.pptx
*.pptx.inspect.ndjson

# Python caches and environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.venv/
venv/
env/
ENV/
.python-version

# Packaging and build products
build/
dist/
*.egg-info/
.eggs/
site/
docs/_build/

# JavaScript/web build products
**/node_modules/
**/.next/
**/.wrangler/
**/dist/

# Local credentials and machine-specific configuration
.env
.env.*
!.env.example
*.pem
*.key

# Native/profiler build products. Text/CSV exports remain publishable.
*.so
*.o
*.a
*.ncu-rep
*.nsys-rep
*.sqlite
nsys_profiles/
nsys_offline_profiles/

# Transient experiment outputs outside a curated study data tree
/logs/
/batch_results/
/dummy_requests/
/offline_batch_results/
/offline_batch_results_deepseek_v32/
/offline_batch_results_deepseek_v32_quant/

# The page-size study keeps the complete local data collection in place, but only
# the explicitly curated report-14/15/16 evidence directories are versioned.
/studies/kv-cache-page-size/data/raw/*
!/studies/kv-cache-page-size/data/raw/report-14-shared-prefix-page-kernel-rtx5060ti/
!/studies/kv-cache-page-size/data/raw/report-14-shared-prefix-page-kernel-rtx5060ti/**
!/studies/kv-cache-page-size/data/raw/report-15-gray-log-forensics/
!/studies/kv-cache-page-size/data/raw/report-15-gray-log-forensics/**
!/studies/kv-cache-page-size/data/raw/report-16-shared-prefix-engine/
!/studies/kv-cache-page-size/data/raw/report-16-shared-prefix-engine/**
!/studies/kv-cache-page-size/data/raw/report-16-true-batch-engine/
!/studies/kv-cache-page-size/data/raw/report-16-true-batch-engine/**
!/studies/kv-cache-page-size/data/raw/report-16-ncu-primary/
!/studies/kv-cache-page-size/data/raw/report-16-ncu-primary/**
!/studies/kv-cache-page-size/data/raw/report-16-mechanism-sweep/
!/studies/kv-cache-page-size/data/raw/report-16-mechanism-sweep/**
!/studies/kv-cache-page-size/data/raw/report-16-verification/
!/studies/kv-cache-page-size/data/raw/report-16-verification/**

# Reassert safety exclusions inside allow-listed evidence directories. Git's
# last-match rule means these must follow the raw-data negation rules above.
**/.DS_Store
**/Thumbs.db
**/~$*.pptx
**/*.pptx.inspect.ndjson
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/.coverage.*
**/htmlcov/
**/.tox/
**/.nox/
**/.hypothesis/
**/.venv/
**/venv/
**/env/
**/ENV/
**/.python-version
**/build/
**/dist/
**/*.egg-info/
**/.eggs/
**/site/
**/node_modules/
**/.next/
**/.wrangler/
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.so
**/*.o
**/*.a
**/*.ncu-rep
**/*.nsys-rep
**/*.sqlite
**/nsys_profiles/
**/nsys_offline_profiles/
**/*.done
**/progress.txt
**/*.tgz
**/*.tar
**/*.tar.gz
**/*.zip
